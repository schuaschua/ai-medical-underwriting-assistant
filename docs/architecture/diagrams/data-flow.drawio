        <object id="stamp" label="Drawn 2026-10-06 from _bmad-output/planning-artifacts/architecture/architecture-ai-medical-underwriting-assistant-2026-10-06/ARCHITECTURE-SPINE.md @ fb6581e (2026-10-06)">
          <mxCell style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;" parent="1" vertex="1">
